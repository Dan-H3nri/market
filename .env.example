# ═══════════════════════════════════════════════════════
# AI Agentic Marketing Engine - Environment Configuration
# ═══════════════════════════════════════════════════════

# ── Primary LLM Model ──────────────────────────────
PRIMARY_MODEL=gpt-4o
PRIMARY_MODEL_URL=https://api.openai.com/v1
PRIMARY_API_KEY=sk-your-primary-key-here

# ── Secondary LLM Model ────────────────────────────
SECONDARY_MODEL=gpt-4o-mini
SECONDARY_MODEL_URL=https://api.openai.com/v1
SECONDARY_API_KEY=sk-your-secondary-key-here

# ── Fallback LLM Model ─────────────────────────────
FALLBACK_MODEL=gpt-3.5-turbo
FALLBACK_MODEL_URL=https://api.openai.com/v1
FALLBACK_API_KEY=sk-your-fallback-key-here

# ── Image Generation ────────────────────────────────
IMAGE_PROVIDER=catgpt
IMAGE_MODEL=dall-e
IMAGE_API_URL=http://localhost:8000/v1
IMAGE_API_KEY=your-image-api-key-here

# ── LangGraph Workflow ──────────────────────────────
MAX_REVIEW_LOOPS=5
MAX_AGENT_RETRIES=3
QUALITY_THRESHOLD=8.5

# ── Database ────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ── Memory ──────────────────────────────────────────
OBSIDIAN_MEMORY_PATH=./memory

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=INFO
